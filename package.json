{
  "name": "astro-leverage-ai-site-rebuild",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "guard:phrases": "node packages/site-standard/scripts/lint-banned-phrases.mjs dist",
    "guard:canonicals": "node packages/site-standard/scripts/validate-canonicals.mjs dist",
    "guard:schema": "node packages/site-standard/scripts/validate-schema.mjs dist",
    "guard:links": "node packages/site-standard/scripts/validate-internal-links.mjs dist",
    "guard:site-standard": "pnpm guard:phrases && pnpm guard:canonicals && pnpm guard:schema && pnpm guard:links",
    "verify": "pnpm check && pnpm build && pnpm guard:site-standard"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@leverageai/site-standard": "workspace:*",
    "astro": "6.4.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "6.0.3",
    "wrangler": "4.105.0"
  }
}
