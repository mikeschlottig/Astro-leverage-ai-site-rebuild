---
/**
 * SeoHead — canonical + robots + Open Graph + Twitter Card block.
 * Fixes audit findings N4 (canonical policy) and N5 (missing social cards).
 * Place inside <head> of the base layout. Pass the same `identity` and `page`
 * objects given to <SchemaGraph />.
 */
import { canonicalFor } from '../canonical.js';
import type { PageMeta, SiteIdentity } from '../types/index.js';

interface Props {
  readonly identity: SiteIdentity;
  readonly page: PageMeta;
}

const { identity, page } = Astro.props as Props;

const canonical = canonicalFor(identity, page.path);
const ogImage = page.ogImageUrl ?? identity.defaultOgImageUrl;
const ogType = page.type === 'article' || page.type === 'caseStudy' ? 'article' : 'website';
---
<title>{page.title}</title>
<meta name="description" content={page.description} />
<link rel="canonical" href={canonical} />
{page.noindex === true && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={identity.name} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={page.title} />
<meta property="og:description" content={page.description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />
{page.type === 'article' && page.datePublished !== undefined && (
  <meta property="article:published_time" content={page.datePublished} />
)}
{page.type === 'article' && page.dateModified !== undefined && (
  <meta property="article:modified_time" content={page.dateModified} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={page.title} />
<meta name="twitter:description" content={page.description} />
<meta name="twitter:image" content={ogImage} />
