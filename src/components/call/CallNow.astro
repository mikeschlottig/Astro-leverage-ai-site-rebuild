---
// Inline "talk now" button for the click-to-call app (/home/mikes/CloudflareRealTime-Admin-App,
// Worker `click-to-call`). widget.js mounts a floating #c2c-btn and binds open() to it; this page hides
// that floating button and clicks it from an inline one instead, so the call app needs no change.
// Without JavaScript the link opens the hosted call page directly.
interface Props {
  label?: string;
}
const { label = "Talk with Mike now" } = Astro.props;
const CALL_ORIGIN = "https://click-to-call.ceo-a53.workers.dev";
---

<a class="button primary call-now" href={`${CALL_ORIGIN}/call`} data-call-now>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
  <span>{label}</span>
</a>
<p class="call-now-note">Video or audio, from your browser. If I am away, my assistant takes your message.</p>

<script is:inline src={`${CALL_ORIGIN}/widget.js`} defer data-label="Talk with Mike"></script>
<script is:inline>
  document.querySelectorAll("[data-call-now]").forEach((link) => {
    link.addEventListener("click", (event) => {
      const widgetButton = document.getElementById("c2c-btn");
      if (!widgetButton) return; // widget blocked or not loaded: follow the link to the hosted call page
      event.preventDefault();
      widgetButton.click();
    });
  });
</script>

<style is:global>
  #c2c-widget-root { display: none; }
</style>
<style>
  .call-now { display: inline-flex; align-items: center; gap: 0.6rem; }
  .call-now svg { width: 1.1rem; height: 1.1rem; }
  .call-now-note { margin: 0.5rem 0 0; color: var(--muted); font-size: 0.9rem; }
</style>
