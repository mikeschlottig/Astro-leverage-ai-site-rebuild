---
import { SITE } from "../../lib/site";
import { EXTERNAL_LINKS } from "../../lib/external-links";
import SocialLinks from "./SocialLinks.astro";
---

<footer class="section">
  <div class="shell surface stack">
    <div>
      <p class="eyebrow">Built For Oregon Service Businesses</p>
      <h2>{SITE.name}</h2>
      <p>{SITE.description}</p>
    </div>
    <div class="split">
      <div>
        <h3>Reach Out</h3>
        <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <p><a href={SITE.phoneHref}>{SITE.phone}</a></p>
        <p>{SITE.location}</p>
        <SocialLinks />
      </div>
      <div>
        <h3>Where Next</h3>
        <ul>
          {SITE.nav.slice(0, 7).map((item) => (
            <li><a href={item.href} data-astro-prefetch>{item.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Decide</h3>
        <ul>
          <li><a href="/guides/" data-astro-prefetch>Buyer Guides</a></li>
          <li><a href="/services/local-seo/local-seo-consultant/" data-astro-prefetch>Local SEO Consultant</a></li>
          <li>
            <a
              href={EXTERNAL_LINKS.oregonVoyagerInterview}
              target="_blank"
              rel="external noopener noreferrer"
            >OregonVoyager Interview ↗</a>
          </li>
          <li><a href="/about/" data-astro-prefetch>About Mike</a></li>
          <li><a href="/contact/" data-astro-prefetch>Request an Audit</a></li>
        </ul>
      </div>
    </div>
    <nav class="footer-legal" aria-label="Legal">
      <a href="/privacy/" data-astro-prefetch>Privacy</a>
      <a href="/terms/" data-astro-prefetch>Terms</a>
      <a href="/intellectual-property/" data-astro-prefetch>Copyright &amp; IP</a>
      <a href="/accessibility/" data-astro-prefetch>Accessibility</a>
    </nav>
    <p class="footer-copyright">
      © {new Date().getFullYear()} {SITE.legalName}. All rights reserved.
    </p>
  </div>
</footer>
