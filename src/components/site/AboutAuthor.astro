---
import { defaultAuthor, type AuthorProfile } from "../../data/authors";

type Props = {
  author?: AuthorProfile;
  heading?: string;
};

const {
  author = defaultAuthor,
  heading = "About the author",
} = Astro.props;
---

<aside class="about-author" aria-labelledby={`${author.id}-author-heading`}>
  <img
    class="about-author__image"
    src={author.image}
    alt={author.imageAlt}
    width="240"
    height="240"
    loading="lazy"
  />
  <div class="about-author__copy stack">
    <p class="eyebrow">{heading}</p>
    <h2 id={`${author.id}-author-heading`}>{author.name}</h2>
    <p class="about-author__role">{author.role} at {author.organization} · {author.location}</p>
    <p>{author.bio}</p>
    <ul class="about-author__expertise" aria-label={`${author.name} areas of expertise`}>
      {author.expertise.map((item) => <li>{item}</li>)}
    </ul>
    <a href="/about/">More about Mike and Leverage AI</a>
  </div>
</aside>
