---
import "../styles/global.css";
import "@fontsource-variable/familjen-grotesk/wght.css";
import "@fontsource/barlow/latin-300.css";
import "@fontsource/barlow/latin-300-italic.css";
import "@fontsource/barlow/latin-400.css";
import "@fontsource/barlow/latin-400-italic.css";
import "@fontsource/barlow/latin-500.css";
import "@fontsource/barlow/latin-600.css";
import SeoHead from "@leverageai/site-standard/components/SeoHead.astro";
import SchemaGraph from "@leverageai/site-standard/components/SchemaGraph.astro";
import PostHogAnalytics from "../components/PostHogAnalytics.astro";
import type { BreadcrumbItem, FaqItem, PageMeta, PageType } from "@leverageai/site-standard";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import Breadcrumbs from "../components/site/Breadcrumbs.astro";
import { breadcrumbItems } from "../lib/breadcrumbs";
import { IDENTITY, SITE } from "../lib/site";
import { pageTitle } from "../lib/seo";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  pageType?: PageType;
  noindex?: boolean;
  ogImageUrl?: string;
  datePublished?: string;
  dateModified?: string;
  articleSection?: string;
  aboutUrl?: string;
  serviceName?: string;
  serviceArea?: readonly string[];
  faqs?: readonly FaqItem[];
  breadcrumbs?: readonly BreadcrumbItem[];
};

const {
  title,
  description = SITE.description,
  canonicalPath = Astro.url.pathname,
  pageType = "page",
  noindex,
  ogImageUrl,
  datePublished,
  dateModified,
  articleSection,
  aboutUrl,
  serviceName,
  serviceArea,
  faqs,
  breadcrumbs,
} = Astro.props;

const breadcrumbLabel = title ?? "Home";
const page: PageMeta = {
  type: pageType,
  title: pageTitle(title),
  description,
  path: canonicalPath,
  breadcrumbs: breadcrumbs ?? breadcrumbItems(canonicalPath, breadcrumbLabel),
  ...(noindex !== undefined ? { noindex } : {}),
  ...(ogImageUrl !== undefined ? { ogImageUrl } : {}),
  ...(datePublished !== undefined ? { datePublished } : {}),
  ...(dateModified !== undefined ? { dateModified } : {}),
  ...(articleSection !== undefined ? { articleSection } : {}),
  ...(aboutUrl !== undefined ? { aboutUrl } : {}),
  ...(serviceName !== undefined ? { serviceName } : {}),
  ...(serviceArea !== undefined ? { serviceArea } : {}),
  ...(faqs !== undefined ? { faqs } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111214" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <SeoHead identity={IDENTITY} page={page} />
    <SchemaGraph identity={IDENTITY} page={page} />
    <PostHogAnalytics />
  </head>
  <body>
    <SiteHeader />
    <Breadcrumbs items={page.breadcrumbs ?? []} />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
