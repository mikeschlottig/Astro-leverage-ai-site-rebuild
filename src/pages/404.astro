---
import BaseLayout from "../layouts/BaseLayout.astro";
import { webpageGraph } from "../lib/schema";
---

<BaseLayout
  title="Page Not Found"
  description="The page you requested does not exist."
  schema={webpageGraph("/404", "Page Not Found", "The page you requested does not exist.")}
>
  <section class="section">
    <div class="shell surface stack">
      <h1>That page slipped the route graph.</h1>
      <p>Head back to the homepage or use the primary navigation to find the right path.</p>
      <a class="button primary" href="/">Return Home</a>
    </div>
  </section>
</BaseLayout>
