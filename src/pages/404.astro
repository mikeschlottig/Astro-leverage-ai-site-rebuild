---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found"
  description="The page you requested does not exist."
  noindex
>
  <section class="section">
    <div class="shell surface stack">
      <h1>We could not find that page.</h1>
      <p>
        The address may have changed, or the link may be out of date. Start again from the homepage
        or choose a section from the navigation.
      </p>
      <a class="button primary" href="/">Go to the homepage</a>
    </div>
  </section>
</BaseLayout>
