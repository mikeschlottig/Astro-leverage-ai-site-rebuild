---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AboutAuthor from "../../components/site/AboutAuthor.astro";
import { getCollection, render } from "astro:content";

type LinkCard = {
  href: string;
  title: string;
  description: string;
};

export async function getStaticPaths() {
  const entries = await getCollection("reports");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const renderedEntry = await render(entry);
const { Content } = renderedEntry;
const allServices = await getCollection("services");
const allReports = await getCollection("reports");

const relatedServices: LinkCard[] = entry.data.relatedServices.flatMap((slug) => {
  const service = allServices.find((candidate) => candidate.id === slug);
  return service
    ? [
        {
          href: `/services/${service.id}/`,
          title: service.data.title,
          description: service.data.description,
        },
      ]
    : [];
});

const relatedReports: LinkCard[] = entry.data.relatedReports.flatMap((slug) => {
  const report = allReports.find((candidate) => candidate.id === slug && candidate.id !== entry.id);
  return report
    ? [
        {
          href: `/reports/${report.id}/`,
          title: report.data.title,
          description: report.data.description,
        },
      ]
    : [];
});

const researchTypeLabels = {
  original: "Original research",
  synthesis: "Research synthesis",
  "diagnostic-framework": "Diagnostic framework",
} as const;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={`/reports/${entry.id}`}
  pageType="article"
  datePublished={entry.data.publishedAt.toISOString()}
  dateModified={entry.data.updatedAt?.toISOString()}
  articleSection="Reports"
>
  <section class="section">
    <div class="shell stack">
      <div class="case-study-intro">
        <div class="stack">
          <p class="case-study-kicker">Report</p>
          <h1>{entry.data.heroTitle ?? entry.data.title}</h1>
        </div>
        <p>{entry.data.description}</p>
      </div>

      <div class="split">
        <article class="surface stack prose">
          <Content />

          {entry.data.research && (
            <section class="research-notes" aria-labelledby="research-notes-heading">
              <h2 id="research-notes-heading">Research notes</h2>
              <dl>
                <div>
                  <dt>Evidence type</dt>
                  <dd>{researchTypeLabels[entry.data.research.type]}</dd>
                </div>
                <div>
                  <dt>Scope</dt>
                  <dd>{entry.data.research.scope}</dd>
                </div>
                <div>
                  <dt>Collection period</dt>
                  <dd>{entry.data.research.collectionPeriod}</dd>
                </div>
                <div>
                  <dt>Methodology</dt>
                  <dd>{entry.data.research.methodology}</dd>
                </div>
                <div>
                  <dt>Limitations</dt>
                  <dd>{entry.data.research.limitations}</dd>
                </div>
                {entry.data.research.sourceCount !== undefined && (
                  <div>
                    <dt>Named sources</dt>
                    <dd>{entry.data.research.sourceCount}</dd>
                  </div>
                )}
              </dl>
              {entry.data.research.downloadUrl && (
                <a
                  class="button secondary"
                  href={entry.data.research.downloadUrl}
                  download
                >
                  {entry.data.research.downloadLabel ?? "Download supporting data"}
                </a>
              )}
              {entry.data.research.revisionNotes.length > 0 && (
                <div class="stack">
                  <h3>Visible update history</h3>
                  <ul>
                    {entry.data.research.revisionNotes.map((note) => <li>{note}</li>)}
                  </ul>
                </div>
              )}
            </section>
          )}
        </article>

        <aside class="stack">
          <section class="surface stack">
            <p class="eyebrow">TL;DR</p>
            <h2>What this report is really saying.</h2>
            <ul class="case-study-result-list">
              {entry.data.tldr.map((item) => <li>{item}</li>)}
            </ul>
          </section>

          {relatedServices.length > 0 && (
            <section class="surface stack">
              <p class="eyebrow">Supports These Services</p>
              <h2>Where this research becomes actual implementation.</h2>
              <div class="case-study-links">
                {relatedServices.map((service) => (
                  <a class="case-study-link-card" href={service.href} data-astro-prefetch>
                    <span>Service</span>
                    <strong>{service.title}</strong>
                    <p>{service.description}</p>
                  </a>
                ))}
              </div>
            </section>
          )}

          {relatedReports.length > 0 && (
            <section class="surface stack">
              <p class="eyebrow">Continue The Research</p>
              <h2>Build the operating context behind the numbers.</h2>
              <div class="case-study-links">
                {relatedReports.map((report) => (
                  <a class="case-study-link-card" href={report.href} data-astro-prefetch>
                    <span>Related report</span>
                    <strong>{report.title}</strong>
                    <p>{report.description}</p>
                  </a>
                ))}
              </div>
            </section>
          )}

          <section class="surface stack">
            <p class="eyebrow">Next Step</p>
            <h2>Turn the research into a clearer next decision.</h2>
            <div class="button-row">
              <a class="button primary" href="/pricing/" data-astro-prefetch>Review the diagnostic path</a>
              <a class="button secondary" href="/contact/" data-astro-prefetch>Request a market review</a>
            </div>
          </section>
        </aside>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell">
      <AboutAuthor heading="Report author" />
    </div>
  </section>
</BaseLayout>
