---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const reports = (await getCollection("reports")).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const latestReport = reports[0];

const featuredLinks = [
  {
    href: "/pricing/",
    label: "Pricing",
    title: "Diagnostic-Audit Pricing",
    description: "Turn what you learned into a focused diagnostic plan.",
  },
  {
    href: "/locations/",
    label: "Markets",
    title: "Oregon Locations",
    description: "Compare market conditions across 12 Oregon cities.",
  },
  {
    href: "/services/lead-capture-ai-follow-up/",
    label: "Service",
    title: "Lead Capture And AI Follow-Up",
    description: "Build a faster path from first inquiry to real conversation.",
  },
  {
    href: "/services/search-data-architecture/",
    label: "Service",
    title: "Search And Data Architecture",
    description: "Measure what is working and keep your public signals consistent.",
  },
];
---

<BaseLayout
  title="Reports"
  description="Research-backed reports that support the site's claims about local demand, response speed, trust, and technical execution."
>
  <section class="hero reports-hero">
    <div class="shell">
      <div class="reports-hero__panel">
        <div class="reports-hero__copy stack">
          <p class="eyebrow">Oregon Market Intelligence</p>
          <h1>Find the growth constraint before you fund the fix.</h1>
          <p class="reports-hero__lead">
            These reports turn local search behavior, market gaps, and response-time economics into
            practical decisions for Oregon service businesses.
          </p>
          <div class="button-row">
            {latestReport && (
              <a class="button primary" href={`/reports/${latestReport.id}/`}>Read the latest report</a>
            )}
            <a class="button secondary" href="/pricing/">Start with the diagnostic audit</a>
          </div>
        </div>
        <aside class="reports-hero__guide" aria-label="How to use the research library">
          <p class="reports-hero__guide-label">Use the library to decide</p>
          <ol>
            <li><strong>Where to compete</strong><span>Compare Oregon markets and unmet demand.</span></li>
            <li><strong>What to fix first</strong><span>Separate visibility, trust, and response problems.</span></li>
            <li><strong>What to measure</strong><span>Connect the investment to qualified conversations.</span></li>
          </ol>
        </aside>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell stack">
      <div class="case-study-intro">
        <div class="stack">
          <p class="case-study-kicker">Choose A Question</p>
          <h2>Start with the problem costing your business the most.</h2>
        </div>
        <p>
          Each report turns a broad growth problem into evidence, practical implications, and a
          clearer next decision.
        </p>
      </div>

      <div class="grid">
        {reports.map((entry) => (
          <article class="surface stack">
            <p class="eyebrow">Report</p>
            <h3>{entry.data.title}</h3>
            <p>{entry.data.description}</p>
            <ul class="location-card__signals">
              {entry.data.tldr.slice(0, 2).map((item) => <li>{item}</li>)}
            </ul>
            <a class="button secondary" href={`/reports/${entry.id}/`}>Read the report</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell stack">
      <div class="case-study-links">
        {featuredLinks.map((card) => (
          <a class="case-study-link-card" href={card.href}>
            <span>{card.label}</span>
            <strong>{card.title}</strong>
            <p>{card.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
