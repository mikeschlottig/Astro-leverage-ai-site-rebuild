---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import CaseStudyPreviewCard from "../../components/case-studies/CaseStudyPreviewCard.astro";

const caseStudies = await getCollection("caseStudies");
---

<BaseLayout
  title="Portfolio"
  description="Real case studies showing how Leverage AI builds local visibility, authority, and demand-capture systems for Oregon service businesses."
>
  <section class="section">
    <div class="shell stack">
      <div class="surface stack">
        <p class="eyebrow">Real Work, Real Constraints</p>
        <h1>Results without the agency fog.</h1>
        <p>
          See how local visibility, stronger websites, and better information systems were applied
          to actual Oregon businesses and public projects.
        </p>
      </div>

      <div class="grid">
        {caseStudies.map((entry) => <CaseStudyPreviewCard entry={entry} />)}
      </div>
    </div>
  </section>
</BaseLayout>
