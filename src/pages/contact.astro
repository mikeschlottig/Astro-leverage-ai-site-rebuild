---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/contact/ContactForm.astro";
---

<BaseLayout
  title="Contact"
  description="Start a discovery conversation about local demand, trust signals, and faster lead response."
>
  <section class="section">
    <div class="shell split">
      <div class="surface stack">
        <p class="eyebrow">Contact And Conversion</p>
        <h1>Map the leaks before more local demand drifts away.</h1>
        <p>
          Tell me what feels stuck—visibility, the website, lead quality, slow follow-up, or
          something you cannot quite name yet. I will review it personally and tell you the
          clearest next step, even when that step is smaller than a full engagement.
        </p>
        <p>
          Prefer email, or having trouble with the form? Write to
          <a href="mailto:mike@leverageai.network">mike@leverageai.network</a>.
        </p>
        <div class="button-row">
          <a class="button secondary" href="/knowledge-base/what-the-diagnostic-audit-includes/">Read what the audit includes</a>
          <a class="button secondary" href="/pricing/">Review pricing first</a>
        </div>
      </div>
      <div class="surface">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
