---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const industries = await getCollection("industries");
---

<BaseLayout
  title="Search and Lead Response by Industry in Oregon"
  description="Industry-specific AI search, local SEO, and lead-response strategies for Oregon law firms, contractors, home-service companies, and local businesses."
>
  <section class="section">
    <div class="shell stack">
      <div class="surface stack">
        <h1>Search and lead-response strategies built around how each industry wins work.</h1>
        <p>
          A contractor, clinic, professional firm, and home-service company may compete in the same
          city but face very different trust gaps, search behavior, and lead values. Start with the
          industry closest to yours.
        </p>
      </div>
      <div class="grid">
        {industries.map((entry) => (
          <article class="surface stack">
            <h2>{entry.data.title}</h2>
            <p>{entry.data.description}</p>
            <a href={`/industries/${entry.id}/`} data-astro-prefetch>Explore {entry.data.title}</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
