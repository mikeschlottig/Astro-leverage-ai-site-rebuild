---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PRICE_TEXT, pricingStages, retainerTiers } from "../data/pricing";

const pricingPrinciples = [
  "Pay for clarity first, then for the work the diagnosis supports.",
  "Retainers have published ranges, named tiers, and written deliverables.",
  "You own what we build. When the contract period ends, the code and digital assets are yours.",
];

const costDrivers = [
  {
    name: "Market and service competition",
    detail: "A focused Grants Pass service category requires a different research and authority plan than a saturated Portland or multi-city program.",
  },
  {
    name: "Current website condition",
    detail: "A strong site with one weak handoff is a smaller project than a rebuild involving content, trust, accessibility, forms, and migration risk.",
  },
  {
    name: "Google Business Profile and entity cleanup",
    detail: "Category, service, citation, review, and website inconsistencies increase the work required before local visibility can compound.",
  },
  {
    name: "Content and proof readiness",
    detail: "Existing approved copy, project evidence, photos, and market data reduce scope. Creating or organizing those inputs adds real work.",
  },
  {
    name: "Lead routing and measurement",
    detail: "CRM, scheduling, call tracking, missed-call recovery, analytics, and privacy requirements can expand implementation beyond the public pages.",
  },
];

const pricingFaqs = [
  {
    question: "How much does local SEO cost in Oregon?",
    answer: `Leverage AI starts with a ${PRICE_TEXT.audit} AI visibility and intake audit. Scoped implementation is generally ${PRICE_TEXT.implementation}. The Local Demand System retainer is published in three tiers: Foundation ${PRICE_TEXT.foundation} per month, Growth ${PRICE_TEXT.growth} per month, and Specialist ${PRICE_TEXT.specialist} per month. These are Leverage AI ranges, not a universal Oregon average, and final scope follows the market and current system.`,
  },
  {
    question: "Do I need a monthly retainer?",
    answer: "No. A completed audit or a one-time build is a full engagement, and the audit fee is credited toward the website build or other services whether or not you retain us afterward. Retainers fit businesses where competition, profile activity, content, reporting, or multiple markets need continued work with clear ownership and measures.",
  },
  {
    question: "Do you lock clients in or hold their assets?",
    answer: "No. We are for retainers and against lock-in. When the contract period ends, the business owns the code and the digital assets built for it. We do not hold a client's website, content, or accounts hostage.",
  },
  {
    question: "Is Google Business Profile work included?",
    answer: "It can be included when the diagnostic shows that categories, services, service areas, proof, profile governance, or website alignment are part of the constraint. The final scope identifies exactly which profile work is included.",
  },
  {
    question: "What does a website redesign cost?",
    answer: `A focused redesign can fit inside the current ${PRICE_TEXT.implementation} implementation range when scope is bounded. Larger migrations, extensive content, custom applications, ecommerce, or multi-location systems require separate scoping. The buyer guide explains the cost drivers in detail.`,
  },
  {
    question: "Who owns the website, content, and data?",
    answer: "Ownership and administrative access are made explicit in scope. The operating principle is that the business should retain control of its domain, content, code or deployable artifact, analytics, Search Console, Google Business Profile, and lead data.",
  },
];

const supportingLinks = [
  {
    href: "/reports/oregon-market-intel-infrastructure-report/",
    label: "Report",
    title: "Oregon Market Intel Report",
    description: "See why the right investment changes from one Oregon market to the next.",
  },
  {
    href: "/reports/why-speed-wins/",
    label: "Report",
    title: "Why Speed Wins",
    description: "See how slow follow-up quietly turns paid and organic demand into lost revenue.",
  },
  {
    href: "/reports/how-oregon-markets-differ-for-local-service-businesses/",
    label: "Report",
    title: "How Oregon Markets Differ",
    description: "Compare the buying conditions in Bend, Eugene, Grants Pass, and other Oregon markets.",
  },
  {
    href: "/knowledge-base/what-the-diagnostic-audit-includes/",
    label: "Knowledge Base",
    title: "What The Diagnostic Audit Includes",
    description: "See exactly what we review, what you receive, and how the findings shape the next step.",
  },
  {
    href: "/services/local-seo/",
    label: "Service",
    title: "Local SEO",
    description: "The visibility layer that usually anchors city-page and service-area implementation work.",
  },
  {
    href: "/services/ai-search-optimization/search-data-architecture/",
    label: "Service",
    title: "AI Search, Schema & Data Architecture",
    description: "The measurement layer that keeps diagnostic findings tied to outcomes instead of opinions.",
  },
  {
    href: "/guides/website-redesign-cost-for-local-business/",
    label: "Buyer Guide",
    title: "Website Redesign Cost for a Local Business",
    description: "Understand how content, migration, local SEO, integrations, and ownership change redesign scope.",
  },
  {
    href: "/guides/local-seo-consultant-vs-agency/",
    label: "Buyer Guide",
    title: "Local SEO Consultant vs. Agency",
    description: "Compare senior access, production capacity, ownership, communication, and best-fit conditions.",
  },
];
---

<BaseLayout
  title="AI Search and Local SEO Pricing in Oregon"
  description="Published pricing for an AI visibility and intake audit, system implementation, and Local Demand System retainers for Oregon service businesses."
  canonicalPath="/pricing"
  faqs={pricingFaqs}
>
  <section class="hero">
    <div class="shell stack">
      <div class="pricing-hero">
        <article class="pricing-hero__panel">
          <div class="pricing-hero__copy stack">
            <p class="eyebrow">Diagnostic-First Pricing</p>
            <h1>AI search and local SEO pricing that starts with diagnosis.</h1>
            <p class="pricing-hero__lead">
              Every market and every business leaks opportunity in a different place. We find the
              highest-cost problem first, price the fix clearly, and publish the ranges for ongoing
              retainers. We are for retainers and against lock-in: when the contract period ends,
              you own the code and the digital assets.
            </p>
            <div class="button-row">
              <a class="button primary" href="/contact/" data-astro-prefetch>Request the audit</a>
              <a class="button secondary" href="/knowledge-base/what-the-diagnostic-audit-includes/" data-astro-prefetch>See what the audit includes</a>
            </div>
          </div>

          <aside class="pricing-sidecar">
            <p class="pricing-sidecar__label">What determines scope</p>
            <ul class="case-study-result-list">
              <li>How competitive the local market actually is</li>
              <li>How much trust and conversion work the current site needs</li>
              <li>Whether lead-response routing is helping or quietly wasting demand</li>
              <li>How much reporting and authority infrastructure needs to be rebuilt</li>
            </ul>
          </aside>
        </article>
      </div>

      <div class="pricing-principles">
        {pricingPrinciples.map((principle) => (
          <article class="surface stack">
            <p class="pricing-principles__label">Principle</p>
            <h2>{principle}</h2>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="local-seo-cost-heading">
    <div class="shell stack">
      <div class="case-study-intro">
        <div class="stack">
          <p class="case-study-kicker">Cost Drivers</p>
          <h2 id="local-seo-cost-heading">What changes local SEO and website pricing?</h2>
        </div>
        <p>
          The ranges above are useful only when the scope is visible. These are the conditions that
          most often move an Oregon service business toward the low or high end of an engagement.
        </p>
      </div>

      <dl class="pricing-driver-list surface">
        {costDrivers.map((driver) => (
          <div class="pricing-driver-list__item">
            <dt>{driver.name}</dt>
            <dd>{driver.detail}</dd>
          </div>
        ))}
      </dl>

      <div class="table-scroll" tabindex="0" role="region" aria-label="Local SEO engagement comparison">
        <table class="decision-table">
          <caption>How the three engagement stages differ</caption>
          <thead>
            <tr>
              <th scope="col">Decision</th>
              <th scope="col">Audit</th>
              <th scope="col">Implementation</th>
              <th scope="col">Local Demand System retainer</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Best when</th>
              <td>The highest-cost constraint is unclear</td>
              <td>The priority and ownership are agreed</td>
              <td>The system needs continued work and governance</td>
            </tr>
            <tr>
              <th scope="row">Primary output</th>
              <td>Evidence, priorities, and scope</td>
              <td>Working pages, profile changes, routing, or measurement</td>
              <td>Monitoring, content, citations, and reporting</td>
            </tr>
            <tr>
              <th scope="row">Commitment</th>
              <td>One-time, credited toward later work</td>
              <td>Scoped project</td>
              <td>Monthly, in three published tiers</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pricing-faq-heading">
    <div class="shell split">
      <div class="stack">
        <p class="case-study-kicker">Pricing Questions</p>
        <h2 id="pricing-faq-heading">Answers that should be clear before a proposal.</h2>
        <p>
          If ownership, recurring costs, implementation responsibility, or measurement remain
          vague, the price is not yet transparent enough to compare.
        </p>
      </div>
      <div class="service-faq-list">
        {pricingFaqs.map((faq) => (
          <details class="service-faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell stack">
      <div class="case-study-intro">
        <div class="stack">
          <p class="case-study-kicker">Engagement Structure</p>
          <h2>Start with the problem. Build only what the diagnosis supports.</h2>
        </div>
        <p>
          These ranges cover three practical stages of the work: finding the leak, fixing it, and
          improving the system as your market changes. You will know what is included before the
          work begins. The first two steps are one-time engagements; the retainer tiers follow below.
        </p>
      </div>

      <div class="pricing-grid">
        {pricingStages.map((stage) => (
          <article class:list={["pricing-card", "surface", stage.featured && "pricing-card--featured"]}>
            <div class="stack">
              <p class="pricing-card__tier">{stage.tier}</p>
              <p class="pricing-card__tagline">{stage.tagline}</p>
              <p class="pricing-card__range">{stage.range}</p>
              <h3>{stage.name}</h3>
              <p>{stage.summary}</p>
              <p class="pricing-card__setup">{stage.setup}</p>
            </div>
            <ul class="pricing-card__details">
              {stage.details.map((detail) => <li>{detail}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <div class="pricing-credit surface">
        <div class="stack">
          <p class="pricing-credit__label">Build credit</p>
          <h3>The audit fee is credited toward the work that follows, retainer or not.</h3>
        </div>
        <p>
          That keeps the first step outcome-led. You pay to know what is broken, not to sit through a
          vague sales process disguised as strategy. The credit applies to the website build or other
          services whether or not you choose an ongoing contract.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="retainer-heading">
    <div class="shell stack">
      <div class="case-study-intro">
        <div class="stack">
          <p class="case-study-kicker">Local Demand System</p>
          <h2 id="retainer-heading">Three retainer tiers, published.</h2>
        </div>
        <p>
          Retainers keep the system monitored, extended, and reported on. The tiers are cumulative:
          each includes the one before it. When the contract period ends, you own the code and the
          digital assets built for you.
        </p>
      </div>

      <div class="pricing-grid">
        {retainerTiers.map((tier) => (
          <article class:list={["pricing-card", "surface", tier.featured && "pricing-card--featured"]}>
            <div class="stack">
              <p class="pricing-card__tier">Local Demand System</p>
              <p class="pricing-card__tagline">{tier.tagline}</p>
              <p class="pricing-card__range">{tier.range}</p>
              <h3>{tier.name}</h3>
              <p>{tier.summary}</p>
              <p class="pricing-card__setup">{tier.setup}</p>
            </div>
            <ul class="pricing-card__details">
              {tier.details.map((detail) => <li>{detail}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <p>
        Specialist work covers law firms and real estate teams. For law firms, content is verified
        by the attorney before it publishes, and we do not promise case outcomes or rankings.
        <a href="/industries/" data-astro-prefetch>See the industries we serve</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell stack">
      <div class="case-study-intro">
        <div class="stack">
          <p class="case-study-kicker">The Business Case</p>
          <h2>What is better local visibility worth?</h2>
        </div>
        <p>
          One strong map-pack position, a website that earns trust, or a faster reply to a
          high-value lead can be worth far more than the cost of fixing the system. Explore the
          research behind the work, see how Oregon markets differ, and decide where the biggest
          opportunity may be hiding in your business.
        </p>
      </div>
      <div class="case-study-links">
        {supportingLinks.map((card) => (
          <a class="case-study-link-card" href={card.href} data-astro-prefetch>
            <span>{card.label}</span>
            <strong>{card.title}</strong>
            <p>{card.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
