---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { buildServiceTree, hubsOf } from "../../lib/services";

const hubs = hubsOf(buildServiceTree(await getCollection("services")));
---

<BaseLayout
  title="Services"
  description="Internet marketing, local SEO, website design, and software development for Oregon service businesses."
>
  <section class="section">
    <div class="shell stack">
      <div class="surface stack">
        <p class="eyebrow">Find The Constraint</p>
        <h1>Where is your growth system losing good customers?</h1>
        <p>
          You may not need more marketing. You may need to fix the point where customers stop
          finding you, trusting you, contacting you, or hearing back.
        </p>
      </div>
      <div class="grid">
        {hubs.map((hub) => (
          <article class="surface stack">
            <h2><a href={hub.path}>{hub.entry.data.navLabel}</a></h2>
            <p>{hub.entry.data.description}</p>
            <ul class="case-study-result-list">
              {hub.children.map((child) => (
                <li><a href={child.path}>{child.entry.data.navLabel}</a></li>
              ))}
            </ul>
            <a href={hub.path}>See all {hub.entry.data.navLabel} services</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
