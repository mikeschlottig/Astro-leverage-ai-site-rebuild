---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { buildServiceTree, hubsOf } from "../../lib/services";

const hubs = hubsOf(buildServiceTree(await getCollection("services")));
---

<BaseLayout
  title="Services"
  description="AI search optimization, local SEO, lead capture and follow-up, website design, and automation for Oregon service businesses."
>
  <section class="section">
    <div class="shell stack">
      <div class="surface stack">
        <p class="eyebrow">Services For Oregon Businesses</p>
        <h1>Be found by search and AI assistants, then answer every inquiry fast.</h1>
        <p>
          You may not need more marketing. You may need to fix the point where customers stop
          finding you, trusting you, contacting you, or hearing back.
        </p>
      </div>
      <div class="grid">
        {hubs.map((hub) => (
          <article class="surface stack hub-card">
            <h2><a href={hub.path}>{hub.entry.data.navLabel}</a></h2>
            <p>{hub.entry.data.description}</p>
            <ul class="case-study-result-list">
              {hub.children.map((child) => (
                <li><a href={child.path}>{child.entry.data.navLabel}</a></li>
              ))}
            </ul>
            <a href={hub.path}>See all {hub.entry.data.navLabel} services</a>
          </article>
        ))}
      </div>

      <aside class="service-decision-path surface">
        <div class="stack">
          <h2>Comparing providers or pricing a rebuild?</h2>
          <p>
            Settle ownership, scope, senior access, migration risk, and ongoing costs before the
            proposal—not after the work starts.
          </p>
        </div>
        <div class="button-row">
          <a class="button secondary" href="/guides/local-seo-consultant-vs-agency/" data-astro-prefetch>
            Consultant vs. agency
          </a>
          <a class="button secondary" href="/guides/website-redesign-cost-for-local-business/" data-astro-prefetch>
            Website redesign costs
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
