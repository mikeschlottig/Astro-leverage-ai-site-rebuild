---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Services"
  description="Outcome-led service pages for local visibility, custom websites, lead capture, and search data architecture."
>
  <section class="section">
    <div class="shell stack">
      <div class="surface stack">
        <p class="eyebrow">Find The Constraint</p>
        <h1>Where is your growth system losing good customers?</h1>
        <p>
          You may not need more marketing. You may need to fix the point where customers stop
          finding you, trusting you, contacting you, or hearing back.
        </p>
      </div>
      <div class="grid">
        {services.map((service) => (
          <article class="surface stack">
            <h2>{service.data.title}</h2>
            <p>{service.data.description}</p>
            <a href={`/services/${service.id}/`}>See how it works</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
