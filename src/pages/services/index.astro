---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Local SEO, Web Design & Lead Systems"
  description="Local SEO, custom web design, lead generation, AI follow-up, and search architecture services for Oregon businesses."
>
  <section class="section">
    <div class="shell stack">
      <div class="surface stack">
        <p class="eyebrow">Services For Oregon Businesses</p>
        <h1>Local SEO, web design, and lead generation built to work together.</h1>
        <p>
          You may not need more marketing. You may need to fix the point where customers stop
          finding you, trusting you, contacting you, or hearing back.
        </p>
      </div>
      <div class="grid">
        {services.map((service) => (
          <article class="surface stack">
            <h2>{service.data.title}</h2>
            <p>{service.data.description}</p>
            {service.data.methodName && (
              <p class="service-card__method">Delivered through our {service.data.methodName} methodology.</p>
            )}
            <a href={`/services/${service.id}/`} data-astro-prefetch>Explore {service.data.title}</a>
          </article>
        ))}
      </div>

      <aside class="service-decision-path surface">
        <div class="stack">
          <h2>Comparing providers or pricing a rebuild?</h2>
          <p>
            Settle ownership, scope, senior access, migration risk, and ongoing costs before the
            proposal—not after the work starts.
          </p>
        </div>
        <div class="button-row">
          <a class="button secondary" href="/guides/local-seo-consultant-vs-agency/" data-astro-prefetch>
            Consultant vs. agency
          </a>
          <a class="button secondary" href="/guides/website-redesign-cost-for-local-business/" data-astro-prefetch>
            Website redesign costs
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
