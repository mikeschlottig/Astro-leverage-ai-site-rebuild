---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AboutAuthor from "../../components/site/AboutAuthor.astro";
import { getCollection, render } from "astro:content";
import { locations } from "../../data/locations";
import {
  buildServiceTree,
  routeParam,
  serviceBreadcrumbs,
  siblingsOf,
  type ServiceNode,
} from "../../lib/services";

type LinkCard = {
  kind: "Report" | "Knowledge Base" | "Buyer Guide" | "Case Study" | "Location" | "Industry";
  href: string;
  title: string;
  description: string;
};

type Props = { node: ServiceNode };

export async function getStaticPaths() {
  const tree = buildServiceTree(await getCollection("services"));
  return [...tree.values()].map((node) => ({ params: { slug: routeParam(node) }, props: { node } }));
}

const { node } = Astro.props;
const entry = node.entry;
const servicePath = node.path;
const breadcrumbs = serviceBreadcrumbs(node);
const eyebrow =
  entry.data.kind === "spoke"
    ? "Service"
    : entry.data.kind === "subhub"
      ? "Service Area"
      : "Service Hub";
const siblings = siblingsOf(node);
const allReports = await getCollection("reports");
const allKnowledgeBaseEntries = await getCollection("knowledgeBase");
const allGuides = await getCollection("guides");
const allCaseStudies = await getCollection("caseStudies");
const allIndustries = await getCollection("industries");

const relatedReports: LinkCard[] = entry.data.relatedReports.flatMap((slug) => {
  const report = allReports.find((candidate) => candidate.id === slug);
  return report
    ? [
        {
          kind: "Report",
          href: `/reports/${report.id}/`,
          title: report.data.title,
          description: report.data.description,
        },
      ]
    : [];
});

const relatedKnowledgeBase: LinkCard[] = entry.data.relatedKnowledgeBase.flatMap((slug) => {
  const resource = allKnowledgeBaseEntries.find((candidate) => candidate.id === slug);
  return resource
    ? [
        {
          kind: "Knowledge Base",
          href: `/knowledge-base/${resource.id}/`,
          title: resource.data.title,
          description: resource.data.description,
        },
      ]
    : [];
});

const relatedCaseStudies: LinkCard[] = entry.data.relatedCaseStudies.flatMap((slug) => {
  const caseStudy = allCaseStudies.find((candidate) => candidate.id === slug);
  return caseStudy
    ? [
        {
          kind: "Case Study",
          href: `/portfolio/${caseStudy.id}/`,
          title: caseStudy.data.title,
          description: caseStudy.data.description,
        },
      ]
    : [];
});

const relatedLocations: LinkCard[] = entry.data.relatedLocations.flatMap((slug) => {
  const location = locations.find((candidate) => candidate.slug === slug);
  return location
    ? [
        {
          kind: "Location",
          href: `/locations/${location.slug}/`,
          title: `${location.name} market page`,
          description: location.opportunity,
        },
      ]
    : [];
});

const relatedGuides: LinkCard[] = entry.data.relatedGuides.flatMap((slug) => {
  const guide = allGuides.find((candidate) => candidate.id === slug);
  return guide
    ? [
        {
          kind: "Buyer Guide",
          href: `/guides/${guide.id}/`,
          title: guide.data.title,
          description: guide.data.description,
        },
      ]
    : [];
});

const relatedIndustries: LinkCard[] = entry.data.relatedIndustries.flatMap((slug) => {
  const industry = allIndustries.find((candidate) => candidate.id === slug);
  return industry
    ? [
        {
          kind: "Industry",
          href: `/industries/${industry.id}/`,
          title: industry.data.title,
          description: industry.data.description,
        },
      ]
    : [];
});

const supportLinks = [
  ...relatedReports,
  ...relatedKnowledgeBase,
  ...relatedGuides,
  ...relatedCaseStudies,
  ...relatedIndustries,
  ...relatedLocations,
];
const primaryReport = relatedReports[0];
const primaryCaseStudy = relatedCaseStudies[0];
const renderedEntry = entry.body?.trim() ? await render(entry) : null;
const Content = renderedEntry?.Content;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={servicePath}
  pageType="service"
  serviceName={entry.data.phrase}
  faqs={entry.data.faqs}
  breadcrumbs={breadcrumbs}
>
  <section class="hero service-hero">
    <div class="shell stack">
      <div class="service-hero__panel">
        <div class="service-hero__copy stack">
          <p class="eyebrow">{eyebrow}</p>
          <h1>{entry.data.heroTitle ?? entry.data.title}</h1>
          <p class="service-hero__lead">{entry.data.description}</p>
          {entry.data.outcomes.length > 0 && (
            <div class="case-study-chip-row" aria-label="Service outcomes">
              {entry.data.outcomes.map((outcome) => <span class="case-study-chip">{outcome}</span>)}
            </div>
          )}
          <div class="button-row">
            <a class="button primary" href="/contact/" data-astro-prefetch>Request the diagnostic audit</a>
            <a class="button secondary" href="/pricing/" data-astro-prefetch>Review pricing structure</a>
          </div>
        </div>
        <aside class="service-sidecar">
          <p class="service-sidecar__label">Capabilities</p>
          <ul class="service-checklist">
            {entry.data.capabilities.map((capability) => <li>{capability}</li>)}
          </ul>
        </aside>
      </div>

      {entry.data.proofPoints.length > 0 && (
        <div class="service-proof-grid">
          {entry.data.proofPoints.map((point) => (
            <article class="service-proof-card">
              <p>{point}</p>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  {node.children.length > 0 && (
    <section class="section" aria-labelledby="in-this-section">
      <div class="shell stack">
        <div class="stack">
          <p class="eyebrow">In This Section</p>
          <h2 id="in-this-section">{entry.data.phrase} services</h2>
        </div>
        <div class="grid">
          {node.children.map((child) => (
            <article class="surface stack">
              <h3>{child.entry.data.navLabel}</h3>
              <p>{child.entry.data.description}</p>
              <a href={child.path}>See {child.entry.data.navLabel}</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="shell stack">
      <div class="case-study-intro">
        <div class="stack">
          <p class="case-study-kicker">{entry.data.methodName ?? entry.data.title}</p>
          <h2>{entry.data.summary}</h2>
        </div>
        <p>
          Most businesses do not need every layer rebuilt at once. Start with the constraint
          costing you the most, then connect the next pieces only when they will improve the result.
        </p>
      </div>

      <div class="split">
        {Content && (
          <article class="surface stack prose">
            <Content />
          </article>
        )}
        <aside class="stack">
          {entry.data.proofPoints.length > 0 && (
            <section class="surface stack">
              <p class="eyebrow">What Should Get Better</p>
              <h2>The changes you should be able to see, feel, or measure.</h2>
              <ul class="case-study-result-list">
                {entry.data.proofPoints.map((point) => <li>{point}</li>)}
              </ul>
            </section>
          )}

          {entry.data.faqs.length > 0 && (
            <section class="surface stack">
              <p class="eyebrow">Quick Answers</p>
              <h2>Questions buyers usually ask first.</h2>
              <div class="service-faq-list">
                {entry.data.faqs.map((faq) => (
                  <details class="service-faq-item">
                    <summary>{faq.question}</summary>
                    <p>{faq.answer}</p>
                  </details>
                ))}
              </div>
            </section>
          )}
        </aside>
      </div>

      {(entry.data.diagnosticQuestions.length > 0 || entry.data.deliverables.length > 0) && (
        <div class="split">
          {entry.data.diagnosticQuestions.length > 0 && (
            <section class="surface stack">
              <p class="eyebrow">Diagnostic Focus</p>
              <h2>What the audit checks first on this layer.</h2>
              <ul class="case-study-result-list">
                {entry.data.diagnosticQuestions.map((question) => <li>{question}</li>)}
              </ul>
            </section>
          )}

          {entry.data.deliverables.length > 0 && (
            <section class="surface stack">
              <p class="eyebrow">Implementation Moves</p>
              <h2>What usually gets built, cleaned up, or tightened.</h2>
              <ul class="case-study-result-list">
                {entry.data.deliverables.map((deliverable) => <li>{deliverable}</li>)}
              </ul>
            </section>
          )}
        </div>
      )}
    </div>
  </section>

  {supportLinks.length > 0 && (
    <section class="section">
      <div class="shell split">
        <section class="surface stack">
          <p class="eyebrow">Why We Recommend It</p>
          <h2>Research and real work behind the recommendation.</h2>
          <div class="case-study-links">
            {supportLinks.map((link) => (
              <a class="case-study-link-card" href={link.href} data-astro-prefetch>
                <span>{link.kind}</span>
                <strong>{link.title}</strong>
                <p>{link.description}</p>
              </a>
            ))}
          </div>
        </section>

        <aside class="surface stack">
          <h2>What improves when this layer is working</h2>
          <ul class="case-study-result-list">
            {entry.data.outcomes.map((outcome) => <li>{outcome}</li>)}
          </ul>
          <div class="button-row">
            {primaryReport ? (
              <a class="button secondary" href={primaryReport.href} data-astro-prefetch>
                Read {primaryReport.title}
              </a>
            ) : (
              <a class="button secondary" href="/reports/" data-astro-prefetch>Read supporting reports</a>
            )}
            {primaryCaseStudy ? (
              <a class="button primary" href={primaryCaseStudy.href} data-astro-prefetch>
                See proof in practice
              </a>
            ) : (
              <a class="button primary" href="/portfolio/" data-astro-prefetch>See proof in practice</a>
            )}
          </div>
        </aside>
      </div>
    </section>
  )}

  {node.parent && (
    <section class="section" aria-labelledby="more-in-section">
      <div class="shell stack">
        <div class="stack">
          <p class="eyebrow">Part Of</p>
          <h2 id="more-in-section">
            <a href={node.parent.path}>{node.parent.entry.data.navLabel}</a>
          </h2>
        </div>
        {siblings.length > 0 && (
          <ul class="case-study-result-list">
            {siblings.map((sibling) => (
              <li><a href={sibling.path}>{sibling.entry.data.navLabel}</a></li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )}

  <section class="section">
    <div class="shell">
      <section class="case-study-cta">
        <div class="stack">
          <p class="eyebrow">Next Step</p>
          <h2>Not sure this is the problem costing you the most?</h2>
          <p>
            The diagnostic audit shows where good opportunities are being lost before you commit
            to a larger build.
          </p>
        </div>
        <div class="button-row">
          <a class="button primary" href="/contact/" data-astro-prefetch>Request the audit</a>
          <a class="button secondary" href="/knowledge-base/what-the-diagnostic-audit-includes/" data-astro-prefetch>
            See what the audit includes
          </a>
        </div>
      </section>
    </div>
  </section>
  <section class="section">
    <div class="shell">
      <AboutAuthor heading="Your strategist" />
    </div>
  </section>
</BaseLayout>
