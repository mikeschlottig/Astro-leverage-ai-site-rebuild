---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import HomeHero from "../components/site/HomeHero.astro";
import CaseStudyPreviewCard from "../components/case-studies/CaseStudyPreviewCard.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const caseStudies = await getCollection("caseStudies");
const reports = (await getCollection("reports")).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const knowledgeBase = (await getCollection("knowledgeBase")).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<BaseLayout
  title="Local Demand Systems For Oregon Service Businesses"
  description="High-performance websites, local visibility systems, and lead-response infrastructure for Oregon service businesses."
  pageType="home"
>
  <section class="hero">
    <div class="shell">
      <HomeHero />
    </div>
  </section>

  <section class="section">
    <div class="shell stack">
      <div class="surface stack">
        <p class="eyebrow">The Whole Customer Path</p>
        <h2>Being visible is only the beginning. The whole path to a booked job has to work.</h2>
        <p>
          We connect the pieces that local marketing usually leaves scattered: where you appear,
          what customers see when they find you, how easily they can reach you, and how quickly your
          team responds. The result is a system built to turn more local intent into real
          conversations and booked work.
        </p>
      </div>
      <div class="grid">
        {services.map((service) => (
          <article class="surface stack">
            <p class="eyebrow">{service.data.summary}</p>
            <h2>{service.data.title}</h2>
            <p>{service.data.description}</p>
            <a href={`/services/${service.id}/`}>Open service page</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell surface stack">
      <p class="eyebrow">Real Proof</p>
      <h2>See what changes when local visibility, trust, and follow-up start working together.</h2>
      <div class="grid">
        {caseStudies.map((entry) => <CaseStudyPreviewCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell grid">
      <article class="surface stack">
        <p class="eyebrow">Reports</p>
        <h2>Make better growth decisions with research grounded in Oregon markets.</h2>
        {reports.slice(0, 3).map((entry) => (
          <div class="stack">
            <h3>{entry.data.title}</h3>
            <p>{entry.data.description}</p>
            <a href={`/reports/${entry.id}/`}>Read the report</a>
          </div>
        ))}
        <a class="button secondary" href="/reports/">View all reports</a>
      </article>
      <article class="surface stack">
        <p class="eyebrow">Knowledge Base</p>
        <h2>Get clear answers before you decide what to fix.</h2>
        {knowledgeBase.slice(0, 3).map((entry) => (
          <div class="stack">
            <h3>{entry.data.title}</h3>
            <p>{entry.data.description}</p>
            <a href={`/knowledge-base/${entry.id}/`}>Open the guide</a>
          </div>
        ))}
        <a class="button secondary" href="/knowledge-base/">View the knowledge base</a>
      </article>
    </div>
  </section>
</BaseLayout>
