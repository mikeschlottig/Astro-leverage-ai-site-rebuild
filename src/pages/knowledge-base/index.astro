---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("knowledgeBase")).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const supportingLinks = [
  {
    href: "/pricing/",
    label: "Pricing",
    title: "Pricing",
    description: "See the public price ranges and how diagnosis shapes the scope.",
  },
  {
    href: "/reports/why-speed-wins/",
    label: "Report",
    title: "Why Speed Wins",
    description: "See what delayed follow-up can cost when a lead is ready to hire.",
  },
  {
    href: "/contact/",
    label: "Next Step",
    title: "Request The Audit",
    description: "Tell me what feels stuck and get a direct recommendation.",
  },
];
---

<BaseLayout
  title="Knowledge Base"
  description="Durable explainers and educational content that support the public service architecture."
>
  <section class="hero">
    <div class="shell stack">
      <div class="hero-panel">
        <p class="eyebrow">Knowledge Base</p>
        <h1>Clear answers before you spend money fixing the wrong problem.</h1>
        <p>
          Learn what strong local visibility, trustworthy websites, faster follow-up, and cleaner
          search signals actually require—then decide which issue deserves attention first.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell stack">
      <div class="case-study-intro">
        <div class="stack">
          <p class="case-study-kicker">Find Your Question</p>
          <h2>Choose the question closest to your situation.</h2>
        </div>
        <p>
          Each guide explains the problem, why it matters, what good work looks like, and what you
          can do next.
        </p>
      </div>
      <div class="grid">
        {articles.map((entry) => (
          <article class="surface stack">
            <p class="eyebrow">Knowledge Base</p>
            <h3>{entry.data.title}</h3>
            <p>{entry.data.description}</p>
            <a class="button secondary" href={`/knowledge-base/${entry.id}/`}>Read the article</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell stack">
      <div class="case-study-links">
        {supportingLinks.map((card) => (
          <a class="case-study-link-card" href={card.href}>
            <span>{card.label}</span>
            <strong>{card.title}</strong>
            <p>{card.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
