---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
---

<BaseLayout
  title="Blog"
  description="Authority-building articles that support service pages, reports, and local positioning."
>
  <section class="section">
    <div class="shell stack">
      <div class="surface stack">
        <p class="eyebrow">Blog</p>
        <h1>Operator-level articles on the systems behind local demand.</h1>
        <p>
          Practical articles about getting found locally, earning trust faster, and responding
          while a customer is still ready to act—written for owners who want the reasoning, not
          agency filler.
        </p>
      </div>

      <div class="grid">
        {posts.map((entry) => (
          <article class="surface stack">
            <p class="eyebrow">{entry.data.category}</p>
            <h2>{entry.data.title}</h2>
            <p>{entry.data.description}</p>
            <a href={`/blog/${entry.id}/`}>Read the article</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
