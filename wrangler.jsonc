{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "astro-leverage-ai-site-rebuild",
  "main": "./worker/contact.ts",
  "compatibility_date": "2026-06-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CONTACT_NOTIFICATION_EMAIL": "mike@leverageai.network",
    "CONTACT_FROM_EMAIL": "website@leverageai.network",
    "PUBLIC_SITE_ORIGIN": "https://leverageai.network"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
